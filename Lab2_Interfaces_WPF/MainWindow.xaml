<Window x:Class="Lab2_Interfaces_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_Interfaces_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="500">
    <DockPanel>
        <Label DockPanel.Dock="Top" HorizontalAlignment="Center">Label</Label>
        <TextBox VerticalAlignment="Stretch" Width="190" DockPanel.Dock="Left">TextBox</TextBox>
        <StackPanel VerticalAlignment="Bottom" Margin="10,20">
            <Button Content="Button" Width="70"></Button>
        </StackPanel>
        <TextBox VerticalAlignment="Stretch" Width="200" DockPanel.Dock="Right">TextBox</TextBox>
    </DockPanel>
</Window>
