<Window x:Class="Lab2_Interfaces_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_Interfaces_WPF"
        mc:Ignorable="d"
        Title="TextEditor" Height="400" Width="600">
    <Window.Resources>
        <LinearGradientBrush x:Key="LinearPanelBrush">
            <GradientStop Color="Yellow" Offset="0"></GradientStop>
            <GradientStop Color="Aqua" Offset="0.5"></GradientStop>
            <GradientStop Color="Yellow" Offset="1"></GradientStop>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderBrush" Value="White"></Setter>
            <Setter Property="BorderThickness" Value="3"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource LinearPanelBrush}" Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Grid.ColumnSpan="2">
            <StackPanel FocusManager.IsFocusScope="True" Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2">
                <Button ToolTip="Відкрити" Command="Open" >
                    <Image Source="/images/icons8-open-folder-64.png" Width="64" Height="64"></Image>
                </Button>
                <Button ToolTip="Стерти" Command="Delete">
                    <Image Source="/images/icons8-broom-64.png" Width="64" Height="64"></Image>
                </Button>
                <Button ToolTip="Копіювати" Command="Copy">
                    <Image Source="/images/icons8-copy-64.png" Width="64" Height="64"></Image>
                </Button>
                <Button ToolTip="Вставити" Command="Paste">
                    <Image Source="/images/icons8-paste-64.png" Width="64" Height="64"></Image>
                </Button>
            </StackPanel>
        </Border>
        <Border Background="{StaticResource LinearPanelBrush}" Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Grid.ColumnSpan="2">
            <Grid Margin="10, 10">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBox Name="inputText" FontSize="{Binding ElementName=fontSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" VerticalScrollBarVisibility="Visible"></TextBox>
                <DockPanel Grid.Row="1">
                    <Label Content="Розмір шрифту:"></Label>
                    <Slider Margin="4" MinWidth="100" Name="fontSlider" Maximum="100" Minimum="12"></Slider>
                    <Button ToolTip="Зберегти" Command="Save" Style="{x:Null}" Content="OK" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Width="40" Margin="5"></Button>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
