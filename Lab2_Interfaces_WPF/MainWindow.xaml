<Window x:Class="Lab2_Interfaces_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_Interfaces_WPF"
        mc:Ignorable="d"
        Title="TextEditor" Height="400" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button ToolTip="Відкрити">
                <Image Source="/images/icons8-open-folder-64.png" Width="64" Height="64"></Image>
            </Button>
            <Button ToolTip="Стерти">
                <Image Source="/images/icons8-broom-64.png" Width="64" Height="64"></Image>
            </Button>
            <Button ToolTip="Копіювати">
                <Image Source="/images/icons8-copy-64.png" Width="64" Height="64"></Image>
            </Button>
            <Button ToolTip="Вставити">
                <Image Source="/images/icons8-paste-64.png" Width="64" Height="64"></Image>
            </Button>
        </StackPanel>
        <Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10"></Border>
        <Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10">
            <Grid Margin="10, 10">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" VerticalScrollBarVisibility="Visible"></TextBox>
                <DockPanel Grid.Row="1">
                    <Button Content="OK" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Width="40" Margin="5"></Button>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
