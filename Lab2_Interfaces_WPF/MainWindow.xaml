<Window x:Class="Lab2_Interfaces_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_Interfaces_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel VerticalAlignment="Center">
        <Label HorizontalAlignment="Center" Margin="0, 20, 0, 0">Label</Label>
        <TextBox MaxWidth="700" Height="20" >TextBox</TextBox>
        <TextBox MaxWidth="700" Height="20">TextBox</TextBox>
        <TextBox MaxWidth="700" Height="20">TextBox</TextBox>
        <TextBox MaxWidth="700" Height="20">TextBox</TextBox>
        <Button HorizontalAlignment="Center" Height="25" Width="250" Margin="0, 50">Button</Button>
    </StackPanel>
</Window>
